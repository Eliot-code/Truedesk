---
// Shell for the pages outside the docs: the landing page and 404.
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead__row">
        <a class="brand" href="/">
          <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
          OpenDesk
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/#download">Download</a>
          <a href="/connect/">Browser viewer</a>
          <a href="https://github.com/treeot/opendesk">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer__row">
        <p>
          OpenDesk is free software under the
          <a href="https://github.com/treeot/opendesk/blob/main/LICENSE">AGPL-3.0</a>.
          Use it only on computers you own or have permission to control.
        </p>
        <nav class="footer__links" aria-label="Footer">
          <a href="/docs/">Docs</a>
          <a href="/docs/security/">Security</a>
          <a href="https://github.com/treeot/opendesk/releases">Releases</a>
          <a href="https://github.com/treeot/opendesk/issues">Issues</a>
          <a href="https://github.com/treeot/opendesk">Source</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
