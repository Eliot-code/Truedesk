---
// Shell for the pages outside the docs: the landing page and 404.
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash.
      try {
        const saved = localStorage.getItem("truedesk-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead" data-masthead>
      <div class="wrap masthead__row">
        <a class="brand" href="/">
          <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true"><g fill="none" stroke-width="6"><circle cx="19" cy="29" r="13" stroke="#22d3ee" /><circle cx="29" cy="19" r="13" stroke="#f5b921" /></g><circle cx="29" cy="19" r="5" fill="#22d3ee" /></svg>
          Truedesk
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/connect/">Browser viewer</a>
          <a class="ghbtn" href="https://github.com/Eliot-code/truedesk" aria-label="Star Truedesk on GitHub">
            <svg class="ghbtn__mark" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.04-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.27-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.46-.55.38A8.014 8.014 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
            <span>Star</span>
            <span class="ghbtn__count" data-stars hidden></span>
          </a>
          <button class="themebtn" type="button" data-theme-toggle aria-label="Switch between light and dark">
            <svg class="themebtn__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="themebtn__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
          <a class="nav__dl" href="/#download">Download</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer__row">
        <p>
          Truedesk is free software under the <a href="https://github.com/Eliot-code/truedesk/blob/main/LICENSE">AGPL-3.0</a>. Use it only on computers you own or have permission to control.
        </p>
        <nav class="footer__links" aria-label="Footer">
          <a href="/docs/">Docs</a>
          <a href="/docs/security/">Security</a>
          <a href="https://github.com/Eliot-code/truedesk/releases">Releases</a>
          <a href="https://github.com/Eliot-code/truedesk/issues">Issues</a>
          <a href="https://github.com/Eliot-code/truedesk">Source</a>
        </nav>
      </div>
    </footer>
    <script>
      // Add a shadow/edge to the sticky header once the page scrolls, and
      // reveal sections as they enter the viewport. Both are opt-in via
      // prefers-reduced-motion; without motion, everything is shown at once.
      const header = document.querySelector("[data-masthead]");
      if (header) {
        const onScroll = () => header.classList.toggle("is-stuck", window.scrollY > 4);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      const reveals = document.querySelectorAll("[data-reveal]");
      const allowMotion = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
      if (allowMotion && "IntersectionObserver" in window && reveals.length) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add("is-in"));
      }

      // Theme toggle: flip between light and dark, remembered across visits.
      const themeBtn = document.querySelector("[data-theme-toggle]");
      themeBtn?.addEventListener("click", () => {
        const root = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const current = root.dataset.theme || (systemDark ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("truedesk-theme", next); } catch {}
      });

      // Live GitHub star count, best-effort. Hidden if the request fails.
      const starEl = document.querySelector<HTMLElement>("[data-stars]");
      if (starEl) {
        fetch("https://api.github.com/repos/Eliot-code/truedesk")
          .then((response) => (response.ok ? response.json() : null))
          .then((data) => {
            const stars = data && typeof data.stargazers_count === "number" ? data.stargazers_count : null;
            // Show the count only once it's worth showing; until then it's a plain "Star" call to action.
            if (stars === null || stars < 50) return;
            starEl.textContent = stars >= 1000 ? (stars / 1000).toFixed(1).replace(/\.0$/, "") + "k" : String(stars);
            starEl.hidden = false;
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
