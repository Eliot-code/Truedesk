---
import Site from "../layouts/Site.astro";
---
<Site title="Page not found · OpenDesk" description="This page doesn't exist.">
  <div class="wrap not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>There's nothing at this address. It may have moved when the site was reorganised.</p>
    <div class="actions">
      <a class="button button--primary" href="/">Go to the home page</a>
      <a class="button button--secondary" href="/docs/">Read the docs</a>
      <a class="button button--secondary" href="/connect/">Open the browser viewer</a>
    </div>
  </div>
</Site>
